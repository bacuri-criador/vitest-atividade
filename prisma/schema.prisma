generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Aluno {
  id         Int      @id @default(autoincrement())
  nome       String
  email      String   @unique
  curso      String
  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("alunos")
}
